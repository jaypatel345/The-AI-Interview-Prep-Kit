# Port the API listens on
PORT=4000
# MongoDB connection string (Atlas free tier works)
MONGODB_URI=mongodb://localhost:27017/prepkit
# Long random string used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Exact origin of the deployed frontend, used for CORS and the Origin check. Local: http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
# Set to "production" when deployed (enables Secure, SameSite=None cookies)
NODE_ENV=development

# --- LLM (any OpenAI-compatible endpoint with a free tier). Used by the API and by `npm run evaluate`. ---
# Default: Google Gemini free tier. Key from https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Requests per minute we allow ourselves (stay under your provider's free-tier limit)
LLM_RPM=8
# Optional. On Gemini Flash, "none" turns off thinking (faster, fewer tokens). Leave empty for providers that do not support it.
LLM_REASONING_EFFORT=none
# Alternative: Groq free tier -> LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile  LLM_REASONING_EFFORT=

# --- Crawling ---
# Pages fetched per company site (homepage included)
CRAWL_MAX_PAGES=8
# Minimum delay between requests to the same host, in ms (robots.txt Crawl-delay wins if larger)
CRAWL_DELAY_MS=400
# Private/loopback targets are allowed when NODE_ENV is not production. Set true to allow them in production too (not recommended).
ALLOW_PRIVATE_URLS=

# --- Batch command ---
# Cases run in parallel (the LLM pacing is shared, so this mainly overlaps crawling with generation)
EVAL_CONCURRENCY=2
# A case that takes longer than this is recorded as failed (TIMEOUT)
EVAL_CASE_TIMEOUT_MS=300000
